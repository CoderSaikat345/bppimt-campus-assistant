# =============================================================================
# BPPIMT Campus Resource Assistant — Monorepo Environment Variables
# =============================================================================
# Copy this file to .env.local (frontend) and .env (backend) and fill values.
# NEVER commit populated .env files to version control.
# =============================================================================

# ── Google OAuth (used by NextAuth on the frontend) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth (frontend) ───────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ── Google Cloud / Vertex AI (used by backend) ────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=          # Path to service account JSON (local dev)
VERTEX_AI_LOCATION=

# ── BigQuery Vector Search ────────────────────────────────────────────────────
BIGQUERY_DATASET=
BIGQUERY_TABLE=

# ── Ingestion Pipeline ────────────────────────────────────────────────────
INGESTION_INPUT_DIR=  # Local path; mount as volume in Cloud Run job

# ── FastAPI Backend ───────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=                  # Same client ID — re-declared for backend
ALLOWED_EMAIL_DOMAIN=bppimt.ac.in

# ── Frontend → Backend Communication ─────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
